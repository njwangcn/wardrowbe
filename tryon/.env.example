# 复制为 tryon/.env（此文件被 .gitignore 忽略，不会提交）。
# 只需 4 项；其余可选。中转站 = 任意 OpenAI 兼容的图像模型服务。

# 中转站地址，一般带到 /v1
TRYON_BASE_URL=https://your-relay.example.com/v1
# 中转站密钥
TRYON_API_KEY=sk-xxxxxxxxxxxxxxxx
# 支持出图的模型名（问中转站提供方可用的图像模型）
TRYON_MODEL=gpt-image-1

# chat   -> POST {base}/chat/completions（多模态图进图出，nano-banana / gemini-image / gpt-4o-image 类中转）
# images -> POST {base}/images/generations（gpt-image-* 类中转，image[] 传参考图）
TRYON_MODE=chat

# 可选：中转站路径不标准时，填完整路径或完整 URL
# TRYON_ENDPOINT=
# 可选：超时秒数
# TRYON_TIMEOUT=180
# 可选：自定义指令（留空用内置默认中文指令）
# TRYON_PROMPT=
# 可选：显式代理（默认忽略系统代理，避免被环境代理劫持）
# TRYON_PROXY=http://127.0.0.1:7890
# 可选：本地预览端口
# TRYON_PORT=8787
